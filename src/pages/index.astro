---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { tools, featuredTools } from '../data/tools';
import { coverImage } from '../lib/cover';

const [ans, scaLife] = await Promise.all([
  getCollection('ans'),
  getCollection('sca-life'),
]);

// Doorways into the site. A section hides itself while it has no entries.
const sections = [
  {
    href: '/ans/',
    label: 'Arts & Sciences',
    note: 'Documented projects, class handouts, and research on Ottoman dress, cooking, and performance.',
    count: ans.length,
    unit: 'entries',
  },
  {
    href: '/tools/',
    label: 'Tools',
    note: 'Pattern generators and event calculators. Everything runs in your browser.',
    count: tools.length,
    unit: 'tools',
  },
].filter((s) => s.count > 0);

const kindLabel = {
  project: 'A&S Project',
  handout: 'Class Handout',
  research: 'Research',
};

const recent = [
  ...ans.map((e) => ({ ...e, section: kindLabel[e.data.kind], base: '/ans/' })),
  ...scaLife.map((e) => ({ ...e, section: 'SCA Life', base: '/sca-life/' })),
]
  .sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf() ||
      a.data.title.localeCompare(b.data.title)
  )
  .slice(0, 6);
---
<Base
  title="Home"
  description="Ottoman research, Arts & Sciences documentation, class handouts, and browser tools from Rayhana bint Estafanos al-Abbas, Kingdom of Caid."
>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="rubric">Rayhana&rsquo;s Repositorium</p>
        <h1>Ottoman research, made by hand and written down.</h1>
        <p class="hero-intro dropcap">
          My name is Rayhana bint Estafanos al-Abbas, and I make 16th-century
          Ottoman things: caftans, hats, face veils, shadow puppets, sweets. This
          is where I keep the documentation, my class handouts, and the pattern
          tools I built along the way.
        </p>
        <ul class="hero-links">
          <li><a href="/about/">About me</a></li>
          <li><a href="/ans/">Arts &amp; Sciences</a></li>
          <li><a href="/tools/">Tools</a></li>
        </ul>
      </div>
      <figure class="framed">
        <img
          src="/images/rayhana-portrait.jpg"
          width="900"
          height="1350"
          alt="Rayhana seated in front of a fan of peacock feathers, wearing a red tarpuş with an embroidered band, a white veil, and a white caftan block-printed in blue and red, tied with a green sash."
        />
        <figcaption>
          In my block-printed <a href="/ans/the-ottoman-caftan/">caftan</a> and
          <a href="/ans/ottoman-tarpus/">tarpuş</a>.
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="wrap">
    <h2 class="section-lead">Start here</h2>
    <ul class="signposts">
      {sections.map((s) => (
        <li class="signpost">
          <h3><a href={s.href}>{s.label}</a></h3>
          <p>{s.note}</p>
          <span class="count">{s.count} {s.unit}</span>
        </li>
      ))}
    </ul>
  </div>

  {featuredTools.length > 0 && (
    <section class="band">
      <div class="wrap">
        <p class="rubric">Pattern generators</p>
        <h2>Cut garb to your own measurements</h2>
        <p class="band-note">
          Enter your measurements and get a to-scale cutting diagram with every
          dimension marked. Nothing you type is saved or sent anywhere.
        </p>
        <ul class="feature-grid">
          {featuredTools.map((t) => (
            <li class="feature">
              <h3><a href={t.href}>{t.title}</a></h3>
              <p>{t.summary}</p>
            </li>
          ))}
        </ul>
        <p class="band-more"><a href="/tools/">All tools &rarr;</a></p>
      </div>
    </section>
  )}

  <div class="wrap">
    <h2 class="section-lead">Recently added</h2>
    <ul class="card-grid">
      {recent.map((e) => {
        const cover = coverImage(e.data, e.body);
        return (
          <li class:list={['card', cover && 'has-thumb']}>
            {cover && (
              <img class="card-thumb" src={cover} alt="" loading="lazy" decoding="async" />
            )}
            <p class="meta">{e.section}</p>
            <h3><a href={`${e.base}${e.id}/`}>{e.data.title}</a></h3>
            <p>{e.data.summary}</p>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
