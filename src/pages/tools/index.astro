---
import Base from '../../layouts/Base.astro';
import { tools } from '../../data/tools';

const ansTools = tools.filter((t) => t.group === 'ans');
const generalTools = tools.filter((t) => t.group === 'general');
---
<Base title="Tools">
  <div class="wrap">
    <header class="entry-header">
      <h1>Tools</h1>
      <p class="prose">
        Working calculators and generators. Everything runs in your browser;
        nothing you enter is saved or sent anywhere.
      </p>
    </header>

    <section class="tools-section">
      <h2>A&amp;S Tools</h2>
      <p class="group-note">Pattern generators and project planning for Arts &amp; Sciences competition.</p>
      <ul class="card-grid">
        {ansTools.map((t) => (
          <li class="card">
            <h3><a href={t.href}>{t.title}</a></h3>
            <p>{t.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="tools-section">
      <h2>General SCA Tools</h2>
      <p class="group-note">Event planning and logistics for any SCA gathering.</p>
      <ul class="card-grid">
        {generalTools.map((t) => (
          <li class="card">
            <h3><a href={t.href}>{t.title}</a></h3>
            <p>{t.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .tools-section { margin-bottom: 3rem; }
  .tools-section h2 { font-size: 1.4rem; margin: 2.5rem 0 0.5rem; }
</style>
