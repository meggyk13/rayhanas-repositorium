---
import Base from '../../layouts/Base.astro';
---
<Base title="Kaftan Pattern Generator" description="Free Ottoman kaftan (caftan) pattern generator: pick a length, fit, and sleeve style, enter three measurements, and get a to-scale cutting diagram.">
  <div class="wrap">
    <header class="entry-header prose">
      <p class="meta">Tool</p>
      <h1>Kaftan Pattern Generator</h1>
      <p>
        Pick your design, enter three measurements, and the generator drafts every piece
        to scale. The body panels are cut at your shoulder width, the way the surviving
        garments are; the side gores are shaped at the top to make up the difference and
        fit the body, then flare to the hem. Front gores on the straight center-front
        edges add fullness below the waist, and there are three sleeve choices.
        Background on the garment is in my
        <a href="/handouts/ottoman-costuming-basics/">Ottoman costuming basics handout</a>.
      </p>
      <p class="meta print-only" id="printMeta"></p>
    </header>

    <section class="card no-print design-card" aria-label="Design">
      <h2>Design</h2>

      <label>Length</label>
      <div class="seg" role="group" aria-label="Length">
        <button id="lenShort" aria-pressed="false">Short</button>
        <button id="lenMedium" aria-pressed="false">Medium</button>
        <button id="lenFull" aria-pressed="true">Full</button>
        <button id="lenCustom" aria-pressed="false">Custom</button>
      </div>
      <p class="note" id="lenNote"></p>
      <div id="customLenWrap" hidden>
        <label for="customLen" class="tight">Custom length <span class="hint">shoulder point down to where you want the hem</span></label>
        <input id="customLen" type="number" inputmode="decimal" min="20" max="70" step="0.5" value="50">
      </div>

      <label class="gap">Fit</label>
      <div class="seg" role="group" aria-label="Fit">
        <button id="fitFitted" aria-pressed="false">Fitted</button>
        <button id="fitFull" aria-pressed="true">Full</button>
      </div>
      <p class="note" id="fitNote"></p>

      <label class="gap">Sleeves</label>
      <div class="seg" role="group" aria-label="Sleeve style">
        <button id="slNarrow" aria-pressed="true">Ankle-length narrow</button>
        <button id="slElbow" aria-pressed="false">Elbow with moon</button>
        <button id="slWide" aria-pressed="false">Full-length wide</button>
      </div>
      <p class="note" id="sleeveNote"></p>
      <div id="detachWrap" hidden>
        <label class="detach-label"><input type="checkbox" id="detachCheck"> Add detachable narrow sleeves underneath</label>
        <p class="note" id="detachNote">Narrow sleeves that button onto the shoulder under the elbow sleeve.</p>
      </div>
    </section>

    <div class="gen-grid">
      <section class="card no-print" aria-label="Measurements">
        <h2>Measurements</h2>

        <label for="shoulders">Shoulders <span class="hint">shoulder seam to shoulder seam, straight across the back</span></label>
        <input id="shoulders" type="number" inputmode="decimal" min="10" max="26" step="0.25" value="15">

        <label for="chest">Chest <span class="hint">around the fullest part, over the layers the kaftan will cover</span></label>
        <input id="chest" type="number" inputmode="decimal" min="20" max="80" step="0.25" value="40">

        <label for="waist">Waist <span class="hint">around the natural waist — the body is sized on the larger of chest and waist</span></label>
        <input id="waist" type="number" inputmode="decimal" min="20" max="80" step="0.25" value="34">

        <label for="fabricw">Fabric width <span class="hint">optional — for the layout and yardage below</span></label>
        <input id="fabricw" type="number" inputmode="decimal" min="20" max="120" step="0.5" value="45">

        <p class="note">Everything else is derived: ease from the fit choice, armscye
        from girth, gore widths from the body, waist at 16″ below the shoulder, wrist
        at 24″. Seam allowance is not included.</p>
      </section>

      <section class="card" aria-label="Pattern dimensions">
        <h2>Pattern dimensions</h2>
        <table>
          <tbody>
            <tr><th>P</th><td>Panel width — each front; back is 2 × P</td><td class="val" id="outP"></td></tr>
            <tr><th>L</th><td>Panel length, shoulder to hem</td><td class="val" id="outL"></td></tr>
            <tr><th>A</th><td>Armscye depth — sleeve fold to underarm</td><td class="val" id="outA"></td></tr>
            <tr><th>S</th><td>Sleeve width, opened flat (2 × A)</td><td class="val" id="outS"></td></tr>
            <tr><th>N</th><td id="lblN">Sleeve length</td><td class="val" id="outN"></td></tr>
            <tr id="rowC"><th>C</th><td>Opening at the end of the sleeve, flat</td><td class="val" id="outC"></td></tr>
            <tr id="rowSL"><th>SL</th><td>Arm slit — left open in the front armhole seam</td><td class="val" id="outSL"></td></tr>
            <tr id="rowM"><th>M</th><td>Moon cutout radius — two per sleeve, front and back</td><td class="val" id="outM"></td></tr>
            <tr id="rowK"><th>K</th><td>Slanted cuff — underarm edge shorter by</td><td class="val" id="outK"></td></tr>
            <tr id="rowDN"><th>DN</th><td>Detachable sleeve length</td><td class="val" id="outDN"></td></tr>
            <tr id="rowDW"><th>DW</th><td>Detachable sleeve width, flat — top → wrist</td><td class="val" id="outDW"></td></tr>
            <tr><th>T</th><td>Side gore width at the top</td><td class="val" id="outT"></td></tr>
            <tr><th>U</th><td>Underarm gore — top (to sleeve) → bottom, × height</td><td class="val" id="outU"></td></tr>
            <tr><th>G</th><td>Side gore — height × width at hem</td><td class="val" id="outG"></td></tr>
            <tr id="rowF"><th>F</th><td>Front gore — height × width at hem, right triangle</td><td class="val" id="outF"></td></tr>
          </tbody>
        </table>
        <p class="note">All dimensions rounded up to the nearest ½″. Seam allowance
        is <em>not</em> included — add your usual as you cut.</p>
        <p class="note" id="sweep"></p>
        <div class="warn" id="check" hidden></div>
      </section>
    </div>

    <section class="card diagram-card" id="cutCard" aria-label="Cutting diagram">
      <h2>Cutting diagram — all pieces</h2>
      <figure id="cutFig"></figure>
      <p class="note" id="cutNote"></p>
    </section>

    <section class="card diagram-card" id="sewnCard" aria-label="Assembled view">
      <h2>Assembled view — front</h2>
      <figure id="sewnFig"></figure>
      <p class="note">Teal: the side and front gores. Gold: the underarm gores, set
      straight under each sleeve. From the front you see half of each side piece — the
      other half is on the back. The dashed front gore is the one lapped underneath. Cut
      the neckline after the shoulder seams are sewn — start shallow and deepen to taste.</p>
    </section>

    <section class="card diagram-card" aria-label="Construction">
      <h2>Construction</h2>
      <ol class="steps">
        <li>Sew the two front panels to the back at the shoulders.</li>
        <li>Cut the neckline — a shallow curve at first, deepened after a fitting.</li>
        <li>Sew each sleeve to the body, centering the sleeve on the shoulder seam and
        sewing it to the front and back panel edges from the shoulder down
        <span class="ci" id="cA"></span>, everything still flat.<span id="stepSlit"> On
        the hanging sleeves, leave <span class="ci" id="cSL"></span> of the front seam open,
        starting 1″ below the shoulder — that's the arm slit.</span></li>
        <li>Sew the underarm seam of each sleeve from the opening end, stopping
        <span class="ci" id="cUT2"></span> short of the body.</li>
        <li>Set the underarm gore (U) straight, not on point: sew its wide top edge
        (<span class="ci" id="cUT"></span>) to the open end of the sleeve's underarm seam,
        half on each side, and its two sides to the front and back panel edges just below
        the sleeve.</li>
        <li>Sew the top edge of each side gore (T, <span class="ci" id="cT"></span>) to the
        bottom of the underarm gore, then its long edges to the front and back panel edges
        down to the hem — this closes the sides and fits the body.</li>
        <li id="stepFrontGore">Sew the long straight edge of a front gore to each
        center-front edge, starting <span class="ci" id="cWD"></span> below the shoulder at
        the waist, wide end at the hem. The slanted edge becomes the new front edge, and
        the two gores overlap when the kaftan is closed.</li>
        <li id="stepSleeve"></li>
        <li id="stepDetach">Sew each detachable sleeve into a tube, leaving the last 4″ of
        the seam open at the wrist; close it with small buttons and loops. Sew a loop at
        the top of each sleeve and a button inside the armhole at the shoulder seam, then
        button them in under the elbow sleeves.</li>
        <li>Face the front edges (iç astar), then finish the hem and cuffs. Line the
        body if you're lining.</li>
        <li>Close the front with silk-wrapped buttons (düğme) and thread loops — loops,
        not buttonholes. Add çaprast down the front and at the cuffs if you like.</li>
      </ol>
    </section>

    <section class="card diagram-card" aria-label="Fabric layout">
      <h2>Fabric layout</h2>
      <figure id="layoutFig"></figure>
      <p class="note" id="yardage"></p>
    </section>

    <div class="actions no-print">
      <button id="printBtn">Print pattern sheet</button>
    </div>
  </div>
</Base>

<style>
  .design-card{margin-top:1.5rem}
  .gen-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:1.25rem}
  @media(max-width:720px){.gen-grid{grid-template-columns:1fr}}
  .card h2{margin-top:0}
  label{display:block;font-weight:600;font-size:.92rem;margin:.9rem 0 .25rem}
  label:first-of-type{margin-top:0}
  label.tight{margin-top:.5rem}
  label.gap{margin-top:1.1rem}
  .hint{font-weight:400;opacity:.72;font-size:.82rem;display:block}
  input[type=number]{width:100%;padding:.55rem .7rem;border:1px solid rgba(42,75,141,.28);border-radius:8px;background:#fff;font-family:"IBM Plex Mono",monospace;font-size:1rem}
  input[type=number]:focus{outline:2px solid #3f7a5a;outline-offset:1px}
  .seg{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.25rem}
  .seg button{flex:1;padding:.5rem .6rem;border:1px solid rgba(42,75,141,.28);background:#fff;border-radius:999px;font-size:.88rem;cursor:pointer;white-space:nowrap}
  .seg button[aria-pressed=true]{background:#2a4b8d;border-color:#2a4b8d;color:#fff}
  .seg button:focus-visible{outline:2px solid #b8923a;outline-offset:2px}
  .detach-label{display:flex;align-items:center;gap:.45rem;font-size:.92rem;font-weight:500;margin:.7rem 0 .15rem;cursor:pointer}
  .detach-label input{width:1.1rem;height:1.1rem;accent-color:#2a4b8d}
  table{width:100%;border-collapse:collapse;margin-top:.25rem}
  td,th{padding:.5rem .4rem;border-bottom:1px solid rgba(42,75,141,.28);text-align:left;font-size:.95rem}
  th{font-family:"IBM Plex Mono",monospace;font-weight:500;color:#3f7a5a;width:2.2rem}
  td.val{font-family:"IBM Plex Mono",monospace;font-weight:500;text-align:right;white-space:nowrap}
  .diagram-card{margin-top:1.25rem}
  figure{margin:0}
  figure :global(svg){display:block;width:100%;height:auto;margin-inline:auto}
  .print-only{display:none}
  .note{font-size:.85rem;opacity:.75;margin-top:.6rem}
  .warn, figure :global(.warn){font-size:.9rem;background:#fff4e2;border:1px solid #b8923a;border-radius:8px;padding:.6rem .8rem;margin-top:.75rem}
  figure :global(.note){font-size:.85rem;opacity:.75;margin-top:.6rem}
  .actions{margin-top:1.5rem}
  .actions button{padding:.65rem 1.3rem;border-radius:999px;border:1px solid #2a4b8d;background:#2a4b8d;color:#fff;font-weight:600;font-size:.95rem;cursor:pointer}
  .actions button:focus-visible{outline:2px solid #b8923a;outline-offset:2px}
  .steps{margin:.25rem 0 0;padding-left:1.35rem}
  .steps li{margin:.5rem 0;font-size:.95rem}
  .ci{font-family:"IBM Plex Mono",monospace;font-weight:500;white-space:nowrap}
  @media print{
    .no-print{display:none!important}
    .print-only{display:block}
    .gen-grid{display:block}
    .card{break-inside:avoid;background:#fff!important;border:none!important;box-shadow:none!important;padding:0!important}
    .diagram-card{margin-top:1rem}
    #cutCard,#sewnCard{break-before:page}
    figure :global(svg){max-height:8in}
    .note,.hint{opacity:1}
  }
</style>

<style is:global>
  /* Keep the site frame off the printed pattern sheet. */
  @media print{
    body{background:#fff}
    body > header, body > nav, body > footer,
    .site-header, .site-nav, .site-footer{display:none!important}
  }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  const EIGHTHS = ['','⅛','¼','⅜','½','⅝','¾','⅞'];
  const r8 = (x) => Math.round(x*8)/8;
  function fmt(x){
    const neg = x<0 ? '−' : '';
    x = Math.abs(r8(x));
    const w = Math.floor(x+1e-9), e = Math.round((x-w)*8);
    if (e===8) return neg+(w+1)+'″';
    return neg + (w||e===0 ? w : '') + (e?EIGHTHS[e]:'') + '″';
  }
  const upHalf = (x) => Math.ceil(x*2 - 1e-9)/2;   // round up to the next ½″

  // ---- standards ----
  const WAIST_DEPTH = 16;   // shoulder to waist: where the front gores start
  const SLEEVE_STD  = 24;   // shoulder to wrist: wide and detachable sleeves end here
  const ELBOW_LEN   = 14;   // shoulder to just past the elbow
  const ANKLE_MIN   = 52;   // the narrow sleeve never hangs shorter than this
  const CUFF_FLAT   = 9;    // opening at the end of the narrow sleeve, flat
  const LARGE_GIRTH = 46;   // above this, a full kaftan gets 6″ of ease
  const MIN_FLARE   = 4;    // a side gore is always at least this much wider at the hem than at the top

  const LENGTHS = {
    short:  { val: 26, label: 'Short',  note: 'Hip length — about 26″ from the shoulder. The front gores come out short at this length, adding just a little flare below the waist.' },
    medium: { val: 44, label: 'Medium', note: 'Tea to calf length — about 44″ from the shoulder.' },
    full:   { val: 56, label: 'Full',   note: 'Floor length on a 5′8″ person — about 56″ from the shoulder. Taller or shorter? Use custom.' },
    custom: { val: null, label: 'Custom', note: 'Measure from the shoulder point down to where you want the hem.' },
  };
  const SLEEVES = {
    narrow: {
      label: 'Ankle-length narrow',
      note: 'A long, tapering hanging sleeve to about the ankle. Your arm comes out through a slit left open in the front of the armhole seam, and the sleeve hangs behind.',
      step: 'Finish the edges of the arm slit with a facing or a narrow hem, and hem the end of the hanging sleeve.',
    },
    elbow: {
      label: 'Elbow with moon',
      note: 'An elbow-length sleeve with a crescent (ay) cut into the opening on the front and on the back — the classic outer kaftan sleeve.',
      step: 'Face or hem the moon cutouts and the sleeve opening.',
    },
    wide: {
      label: 'Full-length wide',
      note: 'A roomy sleeve ending at the wrist, its end cut on a slant so it reaches farther over the top of the arm than underneath.',
      step: 'Hem the slanted cuffs; add çaprast at the cuff edge if you like.',
    },
  };
  const state = { len:'full', fit:'full', sleeve:'narrow', detach:false };

  function seg(btns, keys, prop){
    btns.forEach((b, i) => b.addEventListener('click', () => {
      btns.forEach((x, j) => x.setAttribute('aria-pressed', String(i===j)));
      state[prop] = keys[i];
      if (prop==='sleeve' && keys[i]!=='elbow') state.detach = false;
      render();
    }));
  }
  seg([$('lenShort'),$('lenMedium'),$('lenFull'),$('lenCustom')], ['short','medium','full','custom'], 'len');
  seg([$('fitFitted'),$('fitFull')], ['fitted','full'], 'fit');
  seg([$('slNarrow'),$('slElbow'),$('slWide')], ['narrow','elbow','wide'], 'sleeve');

  $('detachCheck').addEventListener('change', function(){ state.detach = this.checked; render(); });
  ['shoulders','chest','waist','customLen','fabricw'].forEach(id => $(id).addEventListener('input', render));

  function dims(){
    const SH = +$('shoulders').value || 0;
    const CH = +$('chest').value || 0;
    const WA = +$('waist').value || 0;
    const girth = Math.max(CH, WA);
    const ease = state.fit==='fitted' ? 2 : (girth >= LARGE_GIRTH ? 6 : 4);
    const LEN = state.len==='custom' ? (+$('customLen').value || 0) : LENGTHS[state.len].val;

    const P = upHalf(SH/2);                       // each front panel; back is 2P on a fold
    const L = upHalf(LEN + 1);                    // shoulder to hem, plus a little for the hem
    const A = upHalf(girth/8 + 4.5);              // armscye depth from girth
    const S = 2*A;                                // sleeve width opened flat
    const C = CUFF_FLAT;                          // narrow sleeve end, flat
    const N = state.sleeve==='narrow' ? Math.max(L, ANKLE_MIN)
            : state.sleeve==='elbow' ? upHalf(ELBOW_LEN + 1)
            : upHalf(SLEEVE_STD + 1);
    const SL = state.sleeve==='narrow' ? A - 1.5 : 0;                  // arm slit in the front armhole seam
    const M = state.sleeve==='elbow' ? Math.min(upHalf(A*0.4), (A-1)/2) : 0;  // moon radius, one mid-face front and back
    const K = state.sleeve==='wide' ? upHalf(A*0.4) : 0;               // slanted cuff: underarm edge shorter by K
    const hasDetach = state.sleeve==='elbow' && state.detach;
    const DN = hasDetach ? upHalf(SLEEVE_STD + 1) : 0;        // detachable sleeve length
    const DW = hasDetach ? upHalf(C + 2) : 0;                 // detachable sleeve at the wrist, flat
    const DT = hasDetach ? Math.max(upHalf(S*0.75), DW + 2) : 0;  // detachable sleeve at the top, flat — room for the upper arm
    const T = Math.max(upHalf(((girth+ease) - 4*P) / 2), 0);  // side gore top: fits the body over the panels
    const UH = Math.max(upHalf(A/3), 3);          // underarm gore height
    const UT = Math.max(T + 2.5, 3);              // underarm gore top, sewn to the sleeve — wider than its bottom (T)
    const GW = Math.max(upHalf((girth+ease)/4), T + MIN_FLARE);  // side gore width at hem — always flares
    const GH = Math.max(upHalf(L - A - UH), 1);   // side gore height: underarm gore to hem
    const FG = upHalf(GW*0.66);                   // front gore two-thirds of the side gore hem
    const FH = upHalf(L - WAIST_DEPTH);           // front gore height: waist to hem
    const hasFront = FH >= 6;                     // very short customs skip the front gores
    return { SH, CH, WA, girth, ease, P, L, A, S, C, N, SL, M, K, T, UH, UT, GW, GH, FG, FH, hasFront, hasDetach, DN, DW, DT };
  }

  // shared helpers
  const dimLine = (fs) => (x1,y1,x2,y2,label,tx,ty,anchor='middle',rot=0) => `
    <line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#3f7a5a" stroke-width="1" vector-effect="non-scaling-stroke"/>
    <text x="${tx}" y="${ty}" font-size="${fs}" fill="#2b2420" text-anchor="${anchor}" ${rot?`transform="rotate(${rot} ${tx} ${ty})"`:''} font-family="IBM Plex Mono,monospace">${label}</text>`;
  const label = (fs,x,y,txt,color='#5a6382',rot=0) =>
    `<text x="${x}" y="${y}" font-size="${fs}" fill="${color}" text-anchor="middle" ${rot?`transform="rotate(${rot} ${x} ${y})"`:''} font-family="Karla,sans-serif">${txt}</text>`;
  const PIECE = 'fill="#fffdf6" stroke="#2b2420" stroke-width="1.6" vector-effect="non-scaling-stroke"';
  const GORE = 'fill="rgba(63,122,90,.18)" stroke="#2b2420" stroke-width="1.6" vector-effect="non-scaling-stroke"';
  const UGORE = 'fill="rgba(201,162,75,.2)" stroke="#2b2420" stroke-width="1.6" vector-effect="non-scaling-stroke"';
  const ARM = (y,x1,x2)=>`<line x1="${x1}" y1="${y}" x2="${x2}" y2="${y}" stroke="#8a94b0" stroke-width="1" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"/>`;

  function cuttingSVG(d){
    const {P,L,S,C,N,SL,M,K,T,UH,UT,GW,GH,FG,FH,hasFront,hasDetach,DN,DW,DT} = d;
    const gap = Math.max(L,N,hasDetach?DN:0)/22;
    const row1w = 3*P + 2*gap;
    // Type size first, from the overall size; then rows spaced so each row's labels clear the next.
    const estW = Math.max(row1w, N, hasDetach?DN:0, GH + gap*4 + UT, FH);
    const estH = L + S + (hasDetach ? DT : 0) + Math.max(GW, UH*2.5) + (hasFront ? FG : 0) + gap*14;
    const fs = Math.max(estW, estH)/44;
    const sp = Math.max(gap*2.6, fs*3.6);                     // space between rows
    const y1 = 0;
    const y2 = L + sp;                                        // sleeve row
    const y2b = y2 + S + (hasDetach ? sp : 0);                // detachable row (if any)
    const y3 = (hasDetach ? y2b + DT : y2 + S) + sp;          // side gore + underarm gore row
    const uX = GH + fs*5 + gap;                               // underarm gore sits right of the side gore
    // short pieces (elbow sleeve, detachable) carry their name to the right instead of inside
    const totW = Math.max(row1w, N, uX + UT + fs*5, FH,
      state.sleeve==='elbow' ? N + fs*15 : 0, hasDetach ? DN + fs*19 : 0);
    const row3h = Math.max(GW, UH + fs*4.6);
    const y4 = y3 + row3h + sp;                               // front gore row
    const totH = hasFront ? y4 + FG + fs*4.4 : y3 + row3h;
    const m = fs*3.4;
    const vb = `${-m-fs*3} ${-m} ${totW+m*2+fs*7} ${totH+m+fs*2}`;
    const dim = dimLine(fs);

    const back = `
      <rect x="0" y="${y1}" width="${P}" height="${L}" ${PIECE}/>
      <line x1="0" y1="${y1}" x2="0" y2="${y1+L}" stroke="#b8923a" stroke-width="2.4" stroke-dasharray="8 4 1.5 4" vector-effect="non-scaling-stroke"/>
      ${label(fs*.92, -fs*.7, y1+L/2, 'fold', '#8a6d1f', -90)}
      ${label(fs*.92, P/2+fs*.3, y1+L/2, 'back — cut 1 on fold', '#5a6382', -90)}
      ${dim(0, y1-fs*1.2, P, y1-fs*1.2, `P ${fmt(P)}`, P/2, y1-fs*1.7)}`;

    const front = (x,n) => `
      <rect x="${x}" y="${y1}" width="${P}" height="${L}" ${PIECE}/>
      ${label(fs*.92, x+P/2+fs*.3, y1+L/2, `front ${n}`, '#5a6382', -90)}
      ${n===1 ? dim(x, y1-fs*1.2, x+P, y1-fs*1.2, `P ${fmt(P)}`, x+P/2, y1-fs*1.7) : ''}`;

    // Sleeves are drawn opened flat: the body end at the left, the top of the arm along the middle.
    const mid = y2 + S/2;
    const sDim = dim(-fs*.9, y2, -fs*.9, y2+S, `S ${fmt(S)}`, -fs*1.4, y2+S/2, 'end');
    const armLine = ARM(mid, 0, N) + label(fs*.7, N*0.6, mid-fs*.35, 'top of arm', '#8a94b0');
    let sleeve;
    if (state.sleeve==='narrow'){
      const s0 = mid + 1, s1 = mid + 1 + SL;   // front half of the armhole edge, from 1″ below the shoulder
      sleeve = `
        <polygon points="0,${y2} ${N},${y2+(S-C)/2} ${N},${y2+(S+C)/2} 0,${y2+S}" ${PIECE}/>
        ${armLine}
        <line x1="0" y1="${s0}" x2="0" y2="${s1}" stroke="#a0341f" stroke-width="3" vector-effect="non-scaling-stroke"/>
        ${label(fs*.75, fs*.9, (s0+s1)/2, `arm slit ${fmt(SL)}`, '#a0341f', -90)}
        ${label(fs*.92, N/2, y2+S*0.3, 'sleeve — cut 2')}
        ${dim(0, y2+S+fs*1.2, N, y2+S+fs*1.2, `N ${fmt(N)}`, N/2, y2+S+fs*2.4)}
        ${sDim}
        ${dim(N+fs*.9, y2+(S-C)/2, N+fs*.9, y2+(S+C)/2, `C ${fmt(C)}`, N+fs*1.4, y2+S/2, 'start')}`;
    } else if (state.sleeve==='elbow'){
      const m1 = y2 + S/4, m2 = y2 + 3*S/4;
      sleeve = `
        <path d="M 0,${y2} L ${N},${y2} L ${N},${m1-M} A ${M} ${M} 0 0 0 ${N},${m1+M} L ${N},${m2-M} A ${M} ${M} 0 0 0 ${N},${m2+M} L ${N},${y2+S} L 0,${y2+S} Z" ${PIECE}/>
        ${ARM(mid, 0, N)}
        <text x="${N-M*0.45}" y="${m1+fs*.25}" font-size="${fs*.75}" fill="#b8923a" text-anchor="middle" font-family="Karla,sans-serif">ay</text>
        <text x="${N-M*0.45}" y="${m2+fs*.25}" font-size="${fs*.75}" fill="#b8923a" text-anchor="middle" font-family="Karla,sans-serif">ay</text>
        ${label(fs*.92, N+fs*11, y2+S/2+fs*.3, 'sleeve — cut 2')}
        ${label(fs*.7, N*0.4, mid-fs*.35, 'top of arm', '#8a94b0')}
        ${dim(0, y2+S+fs*1.2, N, y2+S+fs*1.2, `N ${fmt(N)}`, N/2, y2+S+fs*2.4)}
        ${sDim}
        ${dim(N+fs*.9, m1, N+fs*.9, m1+M, `M ${fmt(M)}`, N+fs*1.4, m1+M/2+fs*.35, 'start')}`;
    } else {
      sleeve = `
        <polygon points="0,${y2} ${N-K},${y2} ${N},${mid} ${N-K},${y2+S} 0,${y2+S}" ${PIECE}/>
        ${armLine}
        ${label(fs*.92, N/2, y2+S*0.3, 'sleeve — cut 2')}
        ${dim(0, y2+S+fs*1.2, N, y2+S+fs*1.2, `N ${fmt(N)} at top of arm`, N/2, y2+S+fs*2.4)}
        ${sDim}
        ${dim(N-K, y2-fs*1.2, N, y2-fs*1.2, `K ${fmt(K)}`, N-K/2, y2-fs*1.7)}`;
    }

    let detachPiece = '';
    if (hasDetach){
      const yb = (x) => y2b + DT - (DT-DW)/2*(x/DN);   // bottom edge (the seam) at x
      detachPiece = `
      <polygon points="0,${y2b} ${DN},${y2b+(DT-DW)/2} ${DN},${y2b+(DT+DW)/2} 0,${y2b+DT}" ${PIECE}/>
      <circle cx="${fs*.9}" cy="${y2b+DT/2}" r="${fs*.45}" fill="none" stroke="#2a4b8d" stroke-width="1.4" vector-effect="non-scaling-stroke"/>
      ${[1,2.1,3.2].map(t=>`<circle cx="${DN-t*fs}" cy="${yb(DN-t*fs)-fs*.6}" r="${fs*.3}" fill="#2a4b8d"/>`).join('')}
      ${label(fs*.92, DN+fs*11, y2b+DT/2-fs*.2, 'detachable sleeve — cut 2')}
      ${label(fs*.75, DN+fs*11, y2b+DT/2+fs*1.1, 'loop at the top · buttons at the wrist', '#2a4b8d')}
      ${dim(0, y2b+DT+fs*1.2, DN, y2b+DT+fs*1.2, `DN ${fmt(DN)}`, DN/2, y2b+DT+fs*2.4)}
      ${dim(-fs*.9, y2b, -fs*.9, y2b+DT, `${fmt(DT)}`, -fs*1.4, y2b+DT/2, 'end')}
      ${dim(DN+fs*.9, y2b+(DT-DW)/2, DN+fs*.9, y2b+(DT+DW)/2, `${fmt(DW)}`, DN+fs*1.4, y2b+DT/2, 'start')}`;
    }

    // side gore: trapezoid drawn sideways — top edge (T) at the left, hem (GW) at the right
    const sideGore = `
      <polygon points="0,${y3+(GW-T)/2} 0,${y3+(GW+T)/2} ${GH},${y3+GW} ${GH},${y3}" ${GORE}/>
      ${label(fs*.92, GH*.55, y3+GW/2+fs*.3, 'side gore — cut 2', '#1d5f5d')}
      ${dim(0, y3+GW+fs*1.2, GH, y3+GW+fs*1.2, `G ${fmt(GH)}`, GH/2, y3+GW+fs*2.4)}
      ${dim(-fs*.9, y3+(GW-T)/2, -fs*.9, y3+(GW+T)/2, `T ${fmt(T)}`, -fs*1.4, y3+GW/2, 'end')}
      ${dim(GH+fs*.9, y3, GH+fs*.9, y3+GW, `${fmt(GW)}`, GH+fs*1.4, y3+GW/2, 'start')}`;

    // underarm gore: upright trapezoid, wide edge up (to the sleeve), narrow edge down (to the side gore)
    const uy = y3 + fs*2.2;
    const uL = uX + (UT-T)/2;
    const underGore = `
      <polygon points="${uX},${uy} ${uX+UT},${uy} ${uL+T},${uy+UH} ${uL},${uy+UH}" ${UGORE}/>
      ${dim(uX, uy-fs*1.0, uX+UT, uy-fs*1.0, `${fmt(UT)} to sleeve`, uX+UT/2, uy-fs*1.5)}
      ${dim(uL, uy+UH+fs*1.0, uL+T, uy+UH+fs*1.0, `${fmt(T)}`, uL+T/2, uy+UH+fs*2.1)}
      ${dim(uX+UT+fs*.9, uy, uX+UT+fs*.9, uy+UH, `${fmt(UH)}`, uX+UT+fs*1.4, uy+UH/2+fs*.35, 'start')}
      ${label(fs*.85, uX+UT/2, uy+UH+fs*3.4, 'underarm gore — cut 2', '#8a6d1f')}`;

    // front gore: right triangle, sideways — straight edge along the top (sewn to center front), hem at the right
    const frontGore = hasFront ? `
      <polygon points="0,${y4} ${FH},${y4} ${FH},${y4+FG}" ${GORE}/>
      ${label(fs*.75, FH/2, y4-fs*.5, 'straight edge — sew to center front', '#1d5f5d')}
      ${dim(0, y4+FG+fs*1.2, FH, y4+FG+fs*1.2, `F ${fmt(FH)}`, FH/2, y4+FG+fs*2.4)}
      ${dim(FH+fs*.9, y4, FH+fs*.9, y4+FG, `${fmt(FG)}`, FH+fs*1.4, y4+FG/2+fs*.35, 'start')}
      ${label(fs*.92, FH/2, y4+FG+fs*3.9, 'front gore — cut 2', '#1d5f5d')}` : '';

    return `<svg viewBox="${vb}" role="img" aria-label="Cutting diagram: back panel ${fmt(P)} wide on the fold by ${fmt(L)} long, two front panels ${fmt(P)} by ${fmt(L)}, two sleeves, two trapezoid side gores, two underarm gores${hasFront?', and two right-triangle front gores':''}">
      ${back}
      ${front(P+gap,1)}${front(2*(P+gap),2)}
      ${dim(row1w+fs*.9, y1, row1w+fs*.9, y1+L, `L ${fmt(L)}`, row1w+fs*1.4, y1+L/2, 'start')}
      ${sleeve}${detachPiece}${sideGore}${underGore}${frontGore}
    </svg>`;
  }

  function sewnSVG(d){
    const {P,L,A,C,N,SL,M,K,T,UH,UT,GW,FG,hasFront,hasDetach,DN,DW,DT} = d;
    const bw = P;                         // body extends ±P from center front
    // From the front you see half of each side piece; the other half is on the back.
    const uTop = UT/2, uBot = T/2, gHem = GW/2;
    const yU = A + UH;                    // bottom of the underarm gore, top of the side gore
    const showN = state.sleeve==='narrow' ? Math.min(N, SLEEVE_STD+4) : N;
    const showDN = hasDetach ? Math.min(DN, SLEEVE_STD+4) : 0;
    const reachX = Math.max(bw+showN, bw+gHem, bw+uTop, hasDetach ? bw+showDN : 0);
    const totW = 2*reachX;
    const totH = L;
    const fs = Math.max(totW, totH)/40;
    const m = fs*5.5;
    const vb = `${-reachX-m} ${-fs*3.4} ${totW+2*m} ${totH+fs*7.4}`;
    const dim = dimLine(fs);

    const bodyOutline = `
      <polygon points="${-bw},0 ${bw},0 ${bw},${A} ${bw+uTop},${A} ${bw+uBot},${yU} ${bw+gHem},${L} ${-bw-gHem},${L} ${-bw-uBot},${yU} ${-bw-uTop},${A} ${-bw},${A}"
        fill="#fffdf6" stroke="#2b2420" stroke-width="1.6" vector-effect="non-scaling-stroke"/>`;
    const side = (s) => `
      <polygon points="${s*bw},${A} ${s*(bw+uTop)},${A} ${s*(bw+uBot)},${yU} ${s*bw},${yU}" fill="rgba(201,162,75,.25)" stroke="#b8923a" stroke-width="1" vector-effect="non-scaling-stroke"/>
      <polygon points="${s*bw},${yU} ${s*(bw+uBot)},${yU} ${s*(bw+gHem)},${L} ${s*bw},${L}" fill="rgba(63,122,90,.18)" stroke="#3f7a5a" stroke-width="1" vector-effect="non-scaling-stroke"/>`;
    // Front gores: each is sewn to its own front's center edge and laps over the other front.
    // The one on top shows; the one underneath is dashed.
    const fGores = hasFront ? `
      <polygon points="0,${WAIST_DEPTH} ${-FG},${L} 0,${L}" fill="none" stroke="#3f7a5a" stroke-width="1" stroke-dasharray="4 3" vector-effect="non-scaling-stroke"/>
      <polygon points="0,${WAIST_DEPTH} ${FG},${L} 0,${L}" fill="rgba(63,122,90,.18)" stroke="#3f7a5a" stroke-width="1" vector-effect="non-scaling-stroke"/>` : '';
    const neckW = P*0.42, neckD = A*0.42;
    const centerFront = `
      <line x1="0" y1="${neckD}" x2="0" y2="${L}" stroke="#2b2420" stroke-width="1.2" vector-effect="non-scaling-stroke"/>
      <path d="M ${-neckW} 0 Q 0 ${neckD*1.9} ${neckW} 0" fill="none" stroke="#2b2420" stroke-width="1.4" vector-effect="non-scaling-stroke"/>`;

    // Sleeves seen from the front: folded along the top of the arm, so A deep at the body.
    const SLV = 'fill="#fffdf6" stroke="#2b2420" stroke-width="1.4" vector-effect="non-scaling-stroke"';
    let sleeves, under = '';
    if (state.sleeve==='narrow'){
      const clipped = showN < N;
      const hEnd = A - (A - C/2)*(showN/N);
      const sl = (s)=>{
        let svg = `<polygon points="${s*bw},0 ${s*(bw+showN)},0 ${s*(bw+showN)},${hEnd} ${s*bw},${A}" ${SLV}/>
          <line x1="${s*(bw+fs*.35)}" y1="1" x2="${s*(bw+fs*.35)}" y2="${1+SL}" stroke="#a0341f" stroke-width="2.4" vector-effect="non-scaling-stroke"/>`;
        if (clipped) svg += `<line x1="${s*(bw+showN)}" y1="0" x2="${s*(bw+showN)}" y2="${hEnd}" stroke="#2b2420" stroke-width="1.4" stroke-dasharray="3 2" vector-effect="non-scaling-stroke"/>`;
        return svg;
      };
      const clipNote = clipped ? label(fs*.8, bw+showN-fs*3.5, hEnd+fs*1.3, `→ ${fmt(N)} total`, '#5a6382') : '';
      sleeves = sl(1)+sl(-1)+label(fs*.8, bw+fs*3.2, 1+SL/2+fs*.3, 'arm slit', '#a0341f')+clipNote;
    } else if (state.sleeve==='elbow'){
      const sl = (s)=>{
        const x1 = s*bw, x2 = s*(bw+N);
        return `<path d="M ${x1},0 L ${x2},0 L ${x2},${A/2-M} A ${M} ${M} 0 0 ${s===1?0:1} ${x2},${A/2+M} L ${x2},${A} L ${x1},${A} Z" ${SLV}/>`;
      };
      if (hasDetach){
        const dEnd = DT/2 - (DT/2 - DW/2)*(showDN/DN);
        const dsl = (s)=>`<polygon points="${s*bw},0 ${s*(bw+showDN)},0 ${s*(bw+showDN)},${dEnd} ${s*bw},${DT/2}"
            fill="#fffdf6" stroke="#2a4b8d" stroke-width="1.2" stroke-dasharray="5 3" vector-effect="non-scaling-stroke"/>`;
        under = dsl(1)+dsl(-1)+label(fs*.7, bw+(N+showDN)/2, dEnd+fs*1.2, 'detachable', '#2a4b8d');
      }
      sleeves = sl(1)+sl(-1);
    } else {
      const sl = (s)=>`<polygon points="${s*bw},0 ${s*(bw+N)},0 ${s*(bw+N-K)},${A} ${s*bw},${A}" ${SLV}/>`;
      sleeves = sl(1)+sl(-1);
    }

    const hem = 4*P + 2*GW + (hasFront ? 2*FG : 0);
    return `<svg viewBox="${vb}" role="img" aria-label="Front view of the assembled kaftan: body ${fmt(2*bw)} across at the shoulders, underarm gores under each sleeve, side gores flaring to the hem${hasFront?', front gores lapping at center front from the waist down':''}, and ${SLEEVES[state.sleeve].label.toLowerCase()} sleeves">
      ${under}
      ${sleeves}
      ${bodyOutline}
      ${side(1)}${side(-1)}
      ${fGores}
      ${centerFront}
      ${label(fs*.92, -bw*0.5, (A+L)/2*.62, 'front', '#5a6382')}
      ${dim(-bw, -fs*1.4, bw, -fs*1.4, `2P ${fmt(2*bw)}`, 0, -fs*1.9)}
      ${dim(-reachX-fs*.9, 0, -reachX-fs*.9, L, `L ${fmt(L)}`, -reachX-fs*1.4, L/2, 'end')}
      ${dim(reachX+fs*.9, 0, reachX+fs*.9, A, `A ${fmt(A)}`, reachX+fs*1.4, A/2+fs*.35, 'start')}
      ${hasFront ? dim(fs*1.0, 0, fs*1.0, WAIST_DEPTH, `waist ${fmt(WAIST_DEPTH)}`, fs*1.5, WAIST_DEPTH-fs*.5, 'start') : ''}
      <text x="0" y="${L+fs*2.4}" font-size="${fs}" fill="#2b2420" text-anchor="middle" font-family="IBM Plex Mono,monospace">hem sweep, all the way around: ${fmt(hem)}</text>
    </svg>`;
  }

  function layoutSVG(d){
    const {P,L,S,N,T,UH,UT,GW,GH,FG,FH,hasFront,hasDetach,DN,DT} = d;
    const FW = +$('fabricw').value || 0;
    const half = FW/2;
    if (!FW) return {svg:'<p class="note">Enter a fabric width to see the layout.</p>', yd:''};
    const need = Math.max(P, S, hasDetach ? DT : 0);
    if (half < need){
      return {svg:`<div class="warn">At ${FW}″ wide, this fabric folds to ${fmt(half)} — narrower than the widest piece (${fmt(need)}: ${need===P?'a body panel':need===S?'the sleeve, opened flat':'the detachable sleeve'}). You can piece the panels, which is entirely period, or choose wider fabric.</div>`, yd:''};
    }
    // Main pieces sit against the fold, end to end. Each leaves a strip of spare width
    // toward the selvages; the gores go first-fit into those strips, measured by their
    // bounding boxes (no nesting), and get their own stretch of fabric only if none fits.
    const segs = [
      {len: L+0.5, label:'back — on fold', h: P},
      {len: L+0.5, label:'fronts — both layers', h: P},
      {len: N+0.5, label:'sleeves — both layers', h: S},
    ];
    if (hasDetach) segs.push({len: DN+0.5, label:'detachable — both', h: DT});
    const gores = [{w: GW, len: GH, code: 'G', name: 'side gores'}];
    if (hasFront) gores.push({w: FG, len: FH, code: 'F', name: 'front gores'});
    gores.push({w: UT, len: UH, code: 'U', name: 'underarm gores'});
    segs.forEach(s => s.used = 0);
    const placed = [];
    let tooWide = false;
    for (const g of gores){
      let host = segs.find(s => half - s.h >= g.w && s.len - s.used >= g.len + 0.5);
      if (!host){
        host = {len: g.len + 0.5, label: '', h: 0, used: 0};
        segs.push(host);
        if (g.w > half) tooWide = true;
      }
      placed.push({g, host, off: host.used});
      host.used += g.len + 0.5;
    }
    let x = 0;
    for (const s of segs){ s.x = x; x += s.len; }
    const total = x;
    const fs = total/44;
    const vb = `${-fs*3} ${-fs*3} ${total+fs*6} ${half+fs*7}`;
    let boxes = '';
    for (const s of segs){
      if (!s.h) continue;
      boxes += `
        <rect x="${s.x}" y="${half-s.h}" width="${s.len}" height="${s.h}" fill="rgba(42,75,141,.12)" stroke="#2a4b8d" stroke-width="1.4" vector-effect="non-scaling-stroke"/>
        ${label(fs*.95, s.x+s.len/2, half-s.h/2, s.label, '#2a4b8d')}`;
    }
    for (const p of placed){
      const gx = p.host.x + p.off + 0.25, gw = Math.min(p.g.w, half);
      boxes += `
        <rect x="${gx}" y="0" width="${p.g.len}" height="${gw}" fill="rgba(63,122,90,.18)" stroke="#3f7a5a" stroke-width="1.2" vector-effect="non-scaling-stroke"/>
        ${label(fs*.9, gx+p.g.len/2, gw/2+fs*.3, p.g.code, '#1d5f5d')}`;
    }
    const svg = `<svg viewBox="${vb}" role="img" aria-label="Fabric folded lengthwise with the back on the fold, then fronts and sleeves along it, and the gores in the spare width toward the selvages">
      <rect x="0" y="0" width="${total}" height="${half}" fill="#fffdf6" stroke="#2b2420" stroke-width="1.4" vector-effect="non-scaling-stroke"/>
      <line x1="0" y1="${half}" x2="${total}" y2="${half}" stroke="#b8923a" stroke-width="2.4" stroke-dasharray="8 4 1.5 4" vector-effect="non-scaling-stroke"/>
      ${label(fs, total/2, half+fs*2.2, 'lengthwise fold — selvages at the top', '#8a6d1f')}
      ${boxes}
      <text x="${total/2}" y="${-fs*1.2}" font-size="${fs}" fill="#2b2420" text-anchor="middle" font-family="IBM Plex Mono,monospace">${fmt(total)} of fabric</text>
    </svg>`;
    const yards = Math.ceil((total/36)*4)/4;
    const own = placed.filter(p => !p.host.h).map(p => p.g.name);
    const inside = gores.map(g => g.name).filter(n => !own.includes(n));
    const goreNote = !own.length
      ? 'All the gores fit in the spare width beside the main pieces (G side, F front, U underarm).'
      : !inside.length
        ? 'The gores need their own stretch of fabric at this width.'
        : `The ${inside.join(' and ')} fit in the spare width beside the main pieces; the ${own.join(' and ')} need their own stretch of fabric at this width.`;
    const wideNote = tooWide ? ' The side gores are wider than the folded fabric — piece them.' : '';
    return {svg, yd:`About ${yards} yd of ${FW}″ fabric (${fmt(total)} along the fold), before shrinkage and without seam allowance — wash first and add a little for both. ${goreNote}${wideNote} Cutting through the folded fabric yields both fronts, both sleeves${hasDetach?', both detachable sleeves':''}, and both of each gore at once.`};
  }

  function render(){
    const d = dims();
    const sv = SLEEVES[state.sleeve];
    $('lenNote').textContent = LENGTHS[state.len].note;
    $('customLenWrap').hidden = state.len!=='custom';
    $('fitNote').textContent = state.fit==='fitted'
      ? 'Fitted: 2″ of ease over the larger of chest and waist — closer to the body, like a zibin or underlayer kaftan.'
      : `Full: ${d.girth >= LARGE_GIRTH ? 6 : 4}″ of ease over the larger of chest and waist — the standard outer kaftan, room for the layers underneath.`;
    $('sleeveNote').textContent = sv.note;
    $('stepSleeve').textContent = sv.step;
    $('detachWrap').hidden = state.sleeve!=='elbow';
    $('detachCheck').checked = state.detach;
    $('stepDetach').style.display = d.hasDetach ? '' : 'none';
    $('stepFrontGore').style.display = d.hasFront ? '' : 'none';
    $('stepSlit').style.display = state.sleeve==='narrow' ? '' : 'none';
    $('rowF').style.display = d.hasFront ? '' : 'none';
    $('lblN').textContent = state.sleeve==='narrow' ? 'Sleeve length — hangs to the ankle'
      : state.sleeve==='elbow' ? 'Sleeve length — shoulder to opening' : 'Sleeve length, shoulder to cuff at the top of the arm';
    $('rowC').style.display = state.sleeve==='narrow' ? '' : 'none';
    $('rowSL').style.display = state.sleeve==='narrow' ? '' : 'none';
    $('rowM').style.display = state.sleeve==='elbow' ? '' : 'none';
    $('rowK').style.display = state.sleeve==='wide' ? '' : 'none';
    $('rowDN').style.display = d.hasDetach ? '' : 'none';
    $('rowDW').style.display = d.hasDetach ? '' : 'none';
    $('outP').textContent = fmt(d.P);
    $('outL').textContent = fmt(d.L);
    $('outA').textContent = fmt(d.A);
    $('outS').textContent = fmt(d.S);
    $('outN').textContent = fmt(d.N);
    $('outC').textContent = fmt(d.C);
    $('outSL').textContent = fmt(d.SL);
    $('outM').textContent = fmt(d.M);
    $('outK').textContent = fmt(d.K);
    $('outT').textContent = fmt(d.T);
    $('outU').textContent = `${fmt(d.UT)} → ${fmt(d.T)} × ${fmt(d.UH)}`;
    if (d.hasDetach){ $('outDN').textContent = fmt(d.DN); $('outDW').textContent = `${fmt(d.DT)} → ${fmt(d.DW)}`; }
    $('outG').textContent = `${fmt(d.GH)} × ${fmt(d.GW)}`;
    $('outF').textContent = `${fmt(d.FH)} × ${fmt(d.FG)}`;
    const bodyRound = 4*d.P + 2*d.T;
    const hem = 4*d.P + 2*d.GW + (d.hasFront ? 2*d.FG : 0);
    $('sweep').textContent = d.girth
      ? `Body around the chest, below the underarm gores: ${fmt(bodyRound)} (${fmt(d.ease)} ease). Hem sweep: ${fmt(hem)}.`
      : '';
    const ck = $('check');
    if (d.T <= 0 && d.girth){
      ck.hidden = false;
      ck.textContent = `Shoulders (${fmt(d.SH)}) are broad enough that the panels alone cover the girth — side gores will come to a point under the underarm gore. Double-check the measurement is seam to seam, not around.`;
    } else if (d.WA > d.CH && state.fit==='fitted'){
      ck.hidden = false;
      ck.textContent = `Waist is larger than chest, so the body is sized on the waist (${fmt(d.WA)}). Fitted will skim, not shape — consider full fit for more drape.`;
    } else ck.hidden = true;
    $('cT').textContent = fmt(d.T);
    $('cUT').textContent = fmt(d.UT);
    $('cUT2').textContent = fmt(d.UT/2);
    $('cA').textContent = fmt(d.A);
    $('cSL').textContent = fmt(d.SL);
    $('cWD').textContent = fmt(WAIST_DEPTH);
    $('printMeta').textContent = `${LENGTHS[state.len].label.toLowerCase()} · ${state.fit} fit (${fmt(d.ease)} ease) · ${sv.label.toLowerCase()} sleeves${d.hasDetach?' + detachable':''} — shoulders ${fmt(d.SH)} · chest ${fmt(d.CH)} · waist ${fmt(d.WA)} — ${new Date().toLocaleDateString()}`;
    $('cutFig').innerHTML = cuttingSVG(d);
    $('cutNote').textContent = 'All pieces to the same scale. Cut fronts, sleeves, and gores through folded fabric to get both at once. Seam allowance is not included.';
    $('sewnFig').innerHTML = sewnSVG(d);
    const lay = layoutSVG(d);
    $('layoutFig').innerHTML = lay.svg;
    $('yardage').textContent = lay.yd;
  }

  $('printBtn').addEventListener('click', ()=> window.print());
  render();
</script>
