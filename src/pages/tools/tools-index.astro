---
import Base from '../../layouts/Base.astro';

const ansTools = [
  {
    href: '/tools/salvar/',
    title: 'Şalvar Pattern Generator',
    summary: 'Enter your measurements and get a to-scale cutting diagram for Turkish pants, with every dimension marked.',
  },
  {
    href: '/tools/caftan/',
    title: 'Kaftan Pattern Generator',
    summary: 'Draft every piece of an Ottoman kaftan to scale — body panels, front and side gores, gussets, and three sleeve styles.',
  },
];

const generalTools = [
  {
    href: '/tools/war-food-planner/',
    title: 'War Food Planner',
    summary: 'Plan camp meals by day and slot, scaled to your party size, with a shopping list and cooler strategy.',
  },
  {
    href: '/tools/award-rec/',
    title: 'Award Recommendation Helper',
    summary: 'A guided worksheet for writing a strong award recommendation to the Crown, in your own words.',
  },
  {
    href: '/tools/packing-list/',
    title: 'Event Packing List',
    summary: 'Build a printable packing list for your whole household, by person and by activity.',
  },
  {
    href: '/tools/gate-calculator/',
    title: 'Gate Calculator',
    summary: 'Track attendance and tally fees at gate. Calculates change, logs each group\'s details, and summarizes your day.',
  },
];
---

<Base title="Tools">
  <div class="wrap">
    <header class="entry-header">
      <h1>Tools</h1>
      <p class="prose">
        Working calculators and generators. Everything runs in your browser;
        nothing you enter is saved or sent anywhere.
      </p>
    </header>

    <section class="tools-section">
      <h2>A&S Tools</h2>
      <p class="section-note">Pattern generators and project planning for Arts & Sciences competition.</p>
      <ul class="card-grid">
        {ansTools.map((t) => (
          <li class="card">
            <h3><a href={t.href}>{t.title}</a></h3>
            <p>{t.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="tools-section">
      <h2>General SCA Tools</h2>
      <p class="section-note">Event planning and logistics for any SCA gathering.</p>
      <ul class="card-grid">
        {generalTools.map((t) => (
          <li class="card">
            <h3><a href={t.href}>{t.title}</a></h3>
            <p>{t.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .tools-section {
    margin-bottom: 48px;
  }

  .tools-section h2 {
    font-size: 1.3rem;
    margin: 32px 0 8px;
    font-weight: 600;
    font-family: EB Garamond, serif;
  }

  .section-note {
    font-size: 0.95rem;
    color: #8a7c68;
    margin: 0 0 20px;
  }
</style>
