---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { coverImage } from '../../lib/cover';
import { articleSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('ans');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const kindLabel = {
  project: 'A&S Project',
  handout: 'Class Handout',
  research: 'Research',
}[entry.data.kind];

const description = entry.data.description ?? entry.data.summary;
const cover = coverImage(entry.data, entry.body);
const schema = [
  articleSchema({
    path: `/ans/${entry.id}/`,
    title: entry.data.title,
    description,
    published: entry.data.date,
    image: cover,
    section: kindLabel,
  }),
];
---
<Base
  title={entry.data.title}
  description={description}
  image={cover ?? undefined}
  imageAlt={cover ? entry.data.title : undefined}
  article={{ published: entry.data.date }}
  schema={schema}
>
  <div class="wrap">
    <header class="entry-header prose">
      <p class="meta">
        {kindLabel} ·
        {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {entry.data.event && ` · ${entry.data.event}`}
        {entry.data.tags.length > 0 && ` · ${entry.data.tags.join(' · ')}`}
      </p>
      <h1>{entry.data.title}</h1>
      {entry.data.pdf && (
        <p><a href={entry.data.pdf}>Download the PDF version</a></p>
      )}
    </header>
    <article class="entry-body prose">
      <Content />
    </article>
    <p class="back-link no-print"><a href="/ans/">&larr; All Arts &amp; Sciences</a></p>
  </div>
</Base>
