---
import '../styles/global.css';
import { website, person } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  // Full <title> text, when "Title · Rayhana's Repositorium" isn't wanted (the home page).
  fullTitle?: string;
  // Share image: a path under /public. Defaults to the site card.
  image?: string;
  imageAlt?: string;
  // Articles get og:type "article" and their publish date.
  article?: { published: Date };
  // Pages search engines shouldn't list (empty sections, 404).
  noindex?: boolean;
  // Structured data (schema.org) for this page, merged into one JSON-LD graph.
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = "Ottoman Arts & Sciences documentation, class handouts, and free pattern tools from Rayhana bint Estafanos al-Abbas, SCA Kingdom of Caid.",
  fullTitle,
  image = '/images/og.jpg',
  imageAlt = "Rayhana's Repositorium",
  article,
  noindex = false,
  schema = [],
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
const pageTitle = fullTitle ?? `${title} · Rayhana's Repositorium`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    website,
    person,
    ...schema,
  ],
};
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/ans/', label: 'A&S', hint: 'Projects & Classes' },
  { href: '/tools/', label: 'Tools', hint: 'Calculators' },
  { href: '/gallery/', label: 'Gallery', hint: 'Every picture' },
  { href: '/about/', label: 'About', hint: 'Who I am' },
];

function isCurrent(href: string) {
  if (!href.startsWith('/')) return false;
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rayhana's Repositorium" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">Rayhana&rsquo;s Repositorium</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <button class="menu-btn" aria-expanded="false" aria-controls="site-menu" data-menu-open>
          Menu
          <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </header>

    <div class="menu-overlay" id="site-menu" role="dialog" aria-modal="true" aria-label="Main menu">
      <div class="menu-top">
        <span class="site-title">Rayhana&rsquo;s Repositorium</span>
        <button class="menu-close" data-menu-close>Close ✕</button>
      </div>
      <ul class="menu-list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="diamond"></span>{item.label}
              {item.hint && <span class="hint">{item.hint}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Rayhana bint Estafanos al-Abbas &middot; Kingdom of Caid &middot;
          <a href="mailto:rayhana@rayhanasrepositorium.com">rayhana@rayhanasrepositorium.com</a>
        </p>
        <p>Not an official publication of the SCA, Inc.</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var overlay = document.getElementById('site-menu');
        var openBtn = document.querySelector('[data-menu-open]');
        var closeBtn = document.querySelector('[data-menu-close]');
        function open() {
          overlay.classList.add('open');
          document.body.classList.add('menu-locked');
          openBtn.setAttribute('aria-expanded', 'true');
          closeBtn.focus();
        }
        function close() {
          overlay.classList.remove('open');
          document.body.classList.remove('menu-locked');
          openBtn.setAttribute('aria-expanded', 'false');
          openBtn.focus();
        }
        openBtn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && overlay.classList.contains('open')) close();
        });
      })();
    </script>
  </body>
</html>
